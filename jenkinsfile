pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                sh '''
                    echo "Running build validations..."
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    # Jenkins workspace already contains your repository files
                    echo "Deploying from current workspace: $(pwd)"
                    
                    docker compose down --remove-orphans || true
                    docker compose up -d --build
                    
                    docker image prune -f
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    sleep 15
                    curl -f http://localhost:8000/docs
                '''
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful!'
        }
        failure {
            sh '''
                docker ps -a
            '''
        }
    }
}
