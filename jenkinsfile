pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                sh '''
                    echo "Running tests or build validations..."
                    # Add your test commands here if applicable
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    APP_DIR="/home/ubuntu/koya-clinic-booking"
                    
                    cd "$APP_DIR"
                    
                    git reset --hard
                    git pull origin main
                    
                    docker compose down --remove-orphans || true
                    docker compose up -d --build
                    
                    docker image prune -f
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    sleep 15
                    curl -f http://localhost:8000/docs
                '''
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful!'
        }
        failure {
            sh '''
                docker ps -a
            '''
        }
    }
}
