pipeline {
    agent any

    stages {

        stage('Deploy') {
            steps {

                sh '''
                APP_DIR=/opt/koya-clinic-booking

                if [ ! -d "$APP_DIR" ]; then
                    git clone git@github.com:Nagaraj991655/koya-clinic-booking.git $APP_DIR
                fi

                cd $APP_DIR

                git reset --hard
                git pull origin main

                docker compose down --remove-orphans || true

                docker compose up -d --build

                docker image prune -f
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                sleep 15

                curl -f http://localhost:8000/docs
                '''
            }
        }
    }

    post {

        success {
            echo 'Deployment Successful'
        }

        failure {
            sh '''
            docker ps -a
            '''
        }
    }
}
